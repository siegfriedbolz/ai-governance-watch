id_ed25519
*.ppk

# --- Private Cowork memory mirror — never commit, even if copied into the repo ---
# The PUBLIC, published library is `memory-mirror/` (MUST stay tracked).
# The PRIVATE personal/project memory mirrors use the *ClaudeCoworkMemory naming
# and live outside this repo; this guard blocks accidental inclusion.
*ClaudeCoworkMemory/
**/*ClaudeCoworkMemory/

# --- Local backups / dumps that may hold private data ---
*.bak
*.orig
*.tmp
*.dump
*.sqlite
*.sqlite3
*.db

# --- Logs (audit log files live in dedicated structured paths) ---
*.log
logs/
!logs/silent_updates.jsonl   # explicitly tracked for audit trail (per plan §7.1)

# --- Local trigger / scratch ---
scratch/
.scratch/
local_runs/

# --- No lock files ---
# The pipeline is single-trigger (one Claude Code Routine). There is no
# parallel local runner, so there are no .locks/<source_id>.lock files and
# no two-writer race to coordinate. (Removed with the dual-trigger model.)

# --- Raw snapshots are NOT excluded ---
# memory-mirror/_raw_snapshots/* are committed (audit trail).
# Binary marking lives in .gitattributes, not here.

# --- MkDocs Material build output (never committed; built in CI/Pages) ---
site/
.cache/

# --- Node / frontend (in case prettier or markdownlint pulls them in) ---
node_modules/
package-lock.json
yarn.lock
.npm/
