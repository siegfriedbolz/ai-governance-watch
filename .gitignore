# --- Environment / secrets ---
# Never commit env files or credentials. Token names are documented in
# docs/secrets-inventory.md; the only production secret (GH_PAT) lives in the
# Claude Code Routine env/vault, never in this repo.
.env
.env.*
*.env
!.env.example
.envrc
.netrc
.pypirc
.git-credentials

# Credential / secret bundles
secrets/
.secrets/
secrets.json
secrets.yaml
secrets.yml
credentials.json
*credentials*.json
client_secret*.json
*service-account*.json
gha-creds-*.json
*.token
.token
*.tokens
token.txt
tokens.txt
token.json

# Keys & certificates
*.pem
*.key
*.p12
*.pfx
*.pkcs12
*.crt
*.cer
*.der
*.csr
*.keystore
*.jks
*.gpg
secring.*
id_rsa
id_dsa
